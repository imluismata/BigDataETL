<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!-- Worker Service (.NET 8) que carga las dimensiones del DataWarehouse
       OpinionesClientesDW desde la base transaccional OpinionesClientesDB. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Si la máquina solo tiene un runtime más nuevo (por ejemplo .NET 10), se ejecuta con ese -->
    <RollForward>Major</RollForward>
    <!-- Almacén de User Secrets propio (cadenas de conexión fuera del código) -->
    <UserSecretsId>opiniones-clientes-carga-dw-worker</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpinionesClientes.Extraccion.Infrastructure\OpinionesClientes.Extraccion.Infrastructure.csproj" />
  </ItemGroup>

</Project>
