<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- API REST de comentarios sociales (simula el servicio externo de la fuente 3) -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Si la máquina solo tiene un runtime más nuevo (por ejemplo .NET 10), se ejecuta con ese -->
    <RollForward>Major</RollForward>
    <UserSecretsId>opiniones-clientes-comentarios-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="33.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Data\social_comments.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
